# Copy this file to .env and adjust values for local development.
# .env is gitignored — never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=feature_flags
POSTGRES_USER=feature_flags
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6380

# --- Backend ---
SERVER_PORT=8080
# HMAC signing key for JWTs. Generate a real one for anything beyond local dev, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MINUTES=60
CACHE_FLAG_TTL_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI rule assistant ---
# mock: deterministic canned responses, no external dependency, always available.
# docker-model-runner: calls a local model through Docker Model Runner's
#   OpenAI-compatible API (http://localhost:12434/engines/v1 on macOS Docker
#   Desktop) — free, no API key, nothing leaves the machine. See the "AI
#   integration" section of README.md and .claude/decisions/ADR-003.
AI_PROVIDER=mock
AI_BASE_URL=http://localhost:12434/engines/v1
AI_MODEL=ai/llama3.2:latest
AI_TIMEOUT_MS=20000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
